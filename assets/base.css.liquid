/* Kinetic Pro — statische Vorschau, später Liquiflow-Konvertierung */
@import url(https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,600;0,9..40,700;1,9..40,400&display=swap);

*,
*::before,
*::after {
  box-sizing: border-box;
}

:root {
  --color-bg: #0a0a0b;
  --color-bg-elevated: #141416;
  --color-text: #f4f4f5;
  --color-text-muted: #a1a1aa;
  --color-accent: #00e5a8;
  --color-accent-dim: rgba(0, 229, 168, 0.15);
  --font-sans: "DM Sans", system-ui, -apple-system, sans-serif;
  --font-display: "Bebas Neue", "Impact", sans-serif;
  --space: clamp(1rem, 4vw, 2rem);
  --radius: 12px;
  --max: 1200px;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: var(--font-sans);
  font-size: 1rem;
  line-height: 1.6;
  color: var(--color-text);
  background: var(--color-bg);
  -webkit-font-smoothing: antialiased;
}

img {
  max-width: 100%;
  height: auto;
  vertical-align: middle;
}

a {
  color: var(--color-accent);
  text-decoration: none;
  transition: opacity 0.2s ease;
}

a:hover {
  opacity: 0.85;
}

:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 3px;
}

.skip-link {
  position: absolute;
  left: -9999px;
  z-index: 999;
  padding: 0.5rem 1rem;
  background: var(--color-accent);
  color: var(--color-bg);
}

.skip-link:focus {
  left: var(--space);
  top: var(--space);
}

/* Layout */
.kp-wrap {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.kp-main {
  flex: 1;
}

.kp-inner {
  width: min(100% - var(--space) * 2, var(--max));
  margin-inline: auto;
}

/* Header */
.kp-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(10, 10, 11, 0.92);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.kp-header__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1rem 0;
  width: min(100% - var(--space) * 2, var(--max));
  margin-inline: auto;
}

.kp-logo {
  font-family: var(--font-display);
  font-size: 1.75rem;
  letter-spacing: 0.06em;
  color: var(--color-text);
}

.kp-logo span {
  color: var(--color-accent);
}

.kp-nav {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

.kp-nav__list {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem 1.5rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

.kp-nav__list a {
  color: var(--color-text-muted);
  font-weight: 600;
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.kp-nav__list a:hover,
.kp-nav__list a[aria-current="page"] {
  color: var(--color-text);
}

.kp-header__actions {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.kp-icon-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 10px;
  color: var(--color-text);
  background: transparent;
  cursor: pointer;
}

.kp-icon-btn:hover {
  border-color: var(--color-accent);
  color: var(--color-accent);
}

.kp-cart-badge {
  font-size: 0.7rem;
  font-weight: 700;
  min-width: 1.25rem;
  text-align: center;
}

/* Mobile nav */
.kp-nav--mobile {
  display: none;
  position: fixed;
  inset: 0;
  top: 0;
  z-index: 60;
  flex-direction: column;
  padding: 5rem var(--space) var(--space);
  background: var(--color-bg);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.kp-nav--mobile.is-open {
  display: flex;
}

.kp-nav--mobile .kp-nav__list {
  flex-direction: column;
  gap: 1.25rem;
}

.kp-nav-toggle {
  display: none;
}

@media (max-width: 900px) {
  .kp-nav--desktop {
    display: none;
  }

  .kp-nav-toggle {
    display: inline-flex;
  }
}

/* Hero */
.kp-hero {
  position: relative;
  min-height: min(78vh, 720px);
  display: grid;
  align-items: end;
  padding: var(--space);
  overflow: hidden;
}

.kp-hero__media {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.kp-hero__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: saturate(1.05) contrast(1.05);
}

.kp-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    var(--color-bg) 0%,
    rgba(10, 10, 11, 0.4) 45%,
    rgba(10, 10, 11, 0.2) 100%
  );
  z-index: 1;
}

.kp-hero__content {
  position: relative;
  z-index: 2;
  width: min(100% - var(--space) * 2, var(--max));
  margin-inline: auto;
  padding-bottom: clamp(2rem, 6vw, 4rem);
}

.kp-hero__eyebrow {
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: var(--color-accent);
  margin: 0 0 0.75rem;
}

.kp-hero__title {
  font-family: var(--font-display);
  font-size: clamp(2.75rem, 8vw, 5rem);
  line-height: 0.95;
  letter-spacing: 0.02em;
  margin: 0 0 1rem;
  max-width: 14ch;
}

.kp-hero__text {
  max-width: 36ch;
  color: var(--color-text-muted);
  margin: 0 0 1.75rem;
  font-size: 1.05rem;
}

/* Buttons */
.kp-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.9rem 1.5rem;
  font-family: inherit;
  font-weight: 700;
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  border: none;
  border-radius: 999px;
  cursor: pointer;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.kp-btn--primary {
  background: var(--color-accent);
  color: var(--color-bg);
}

.kp-btn--primary:hover {
  box-shadow: 0 0 0 3px var(--color-accent-dim);
  transform: translateY(-1px);
}

.kp-btn--ghost {
  background: transparent;
  color: var(--color-text);
  border: 1px solid rgba(255, 255, 255, 0.25);
}

.kp-btn--ghost:hover {
  border-color: var(--color-accent);
  color: var(--color-accent);
}

/* Sections */
.kp-section {
  padding: clamp(3rem, 8vw, 5rem) 0;
}

.kp-section--tight {
  padding-top: 2rem;
}

.kp-section__head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 2rem;
}

.kp-section__title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 2.75rem);
  letter-spacing: 0.04em;
  margin: 0;
}

.kp-section__link {
  font-weight: 600;
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

/* Product grid */
.kp-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 1.5rem;
}

.kp-card {
  background: var(--color-bg-elevated);
  border-radius: var(--radius);
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.06);
  transition: border-color 0.2s ease, transform 0.2s ease;
}

.kp-card:hover {
  border-color: rgba(0, 229, 168, 0.35);
  transform: translateY(-3px);
}

.kp-card__media {
  aspect-ratio: 4 / 5;
  background: #1c1c1f;
}

.kp-card__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.kp-card__body {
  padding: 1.1rem 1.25rem 1.35rem;
}

.kp-card__title {
  font-size: 1rem;
  font-weight: 700;
  margin: 0 0 0.35rem;
  color: var(--color-text);
}

.kp-card__meta {
  font-size: 0.9rem;
  color: var(--color-text-muted);
  margin: 0;
}

.kp-price {
  font-weight: 700;
  color: var(--color-accent);
}

/* Product detail */
.kp-product {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(2rem, 5vw, 3.5rem);
  align-items: start;
}

@media (max-width: 900px) {
  .kp-product {
    grid-template-columns: 1fr;
  }
}

.kp-product__gallery {
  display: grid;
  gap: 0.75rem;
}

.kp-product__hero-img {
  border-radius: var(--radius);
  overflow: hidden;
  background: var(--color-bg-elevated);
  aspect-ratio: 4 / 5;
}

.kp-product__hero-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.kp-product__thumbs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0.5rem;
}

.kp-product__thumbs button {
  padding: 0;
  border: 2px solid transparent;
  border-radius: 8px;
  overflow: hidden;
  cursor: pointer;
  background: none;
}

.kp-product__thumbs button:focus-visible {
  border-color: var(--color-accent);
}

.kp-product__title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 3rem);
  letter-spacing: 0.03em;
  margin: 0 0 0.5rem;
}

.kp-product__vendor {
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--color-text-muted);
  margin: 0 0 1rem;
}

.kp-product__form {
  margin-top: 1.5rem;
  display: grid;
  gap: 1rem;
}

.kp-product__row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  align-items: center;
}

.kp-select {
  padding: 0.65rem 1rem;
  border-radius: 10px;
  border: 1px solid rgba(255, 255, 255, 0.15);
  background: var(--color-bg-elevated);
  color: var(--color-text);
  font-family: inherit;
  min-width: 200px;
}

.kp-tag {
  display: inline-block;
  padding: 0.35rem 0.65rem;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  border-radius: 6px;
  background: rgba(239, 68, 68, 0.2);
  color: #fca5a5;
}

/* Cart */
.kp-cart-table {
  width: 100%;
  border-collapse: collapse;
}

.kp-cart-table th,
.kp-cart-table td {
  text-align: left;
  padding: 1rem 0.75rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.kp-cart-table th {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-text-muted);
}

.kp-qty {
  width: 4rem;
  padding: 0.4rem;
  border-radius: 8px;
  border: 1px solid rgba(255, 255, 255, 0.15);
  background: var(--color-bg-elevated);
  color: var(--color-text);
}

.kp-cart-summary {
  margin-top: 2rem;
  padding: 1.5rem;
  border-radius: var(--radius);
  background: var(--color-bg-elevated);
  border: 1px solid rgba(255, 255, 255, 0.08);
  max-width: 380px;
  margin-left: auto;
}

.kp-cart-summary__row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 0.75rem;
}

.kp-cart-summary__total {
  font-size: 1.25rem;
  font-weight: 800;
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

/* Forms */
.kp-form {
  max-width: 420px;
  display: grid;
  gap: 1rem;
}

.kp-label {
  display: block;
  font-size: 0.8rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-text-muted);
  margin-bottom: 0.35rem;
}

.kp-input {
  width: 100%;
  padding: 0.85rem 1rem;
  border-radius: 10px;
  border: 1px solid rgba(255, 255, 255, 0.15);
  background: var(--color-bg-elevated);
  color: var(--color-text);
  font-family: inherit;
}

.kp-input:focus {
  outline: none;
  border-color: var(--color-accent);
}

/* Footer */
.kp-footer {
  padding: 3rem 0;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  margin-top: auto;
  background: #050506;
}

.kp-footer__grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 2rem;
}

@media (max-width: 768px) {
  .kp-footer__grid {
    grid-template-columns: 1fr;
  }
}

.kp-footer__brand {
  font-family: var(--font-display);
  font-size: 1.5rem;
  letter-spacing: 0.06em;
  margin: 0 0 0.75rem;
}

.kp-footer__text {
  color: var(--color-text-muted);
  font-size: 0.95rem;
  max-width: 32ch;
  margin: 0;
}

.kp-footer__title {
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--color-text-muted);
  margin: 0 0 1rem;
}

.kp-footer__list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.kp-footer__list li {
  margin-bottom: 0.5rem;
}

.kp-footer__list a {
  color: var(--color-text);
}

.kp-footer__bottom {
  margin-top: 2.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  font-size: 0.85rem;
  color: var(--color-text-muted);
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  justify-content: space-between;
}

/* Utilities */
.kp-prose {
  max-width: 65ch;
}

.kp-prose h1 {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 2.5rem);
  letter-spacing: 0.04em;
}

.kp-muted {
  color: var(--color-text-muted);
}

/* Liquiflow: Webflow-Embed-Äquivalent für li-settings:custom (nur Schema, nicht sichtbar) */
.kp-li-embed {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.kp-stack {
  display: grid;
  gap: 0.5rem;
}

/* Brand Highlights */
.kp-highlights__head {
  text-align: center;
  max-width: 56ch;
  margin: 0 auto clamp(2rem, 5vw, 3rem);
}

.kp-eyebrow {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: var(--color-accent);
  margin-bottom: 0.75rem;
}

.kp-section__lead {
  color: var(--color-text-muted);
  font-size: 1.05rem;
  margin: 0.75rem 0 0;
}

.kp-highlights__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: clamp(1.25rem, 3vw, 2rem);
}

.kp-highlights__grid[data-columns="2"] {
  grid-template-columns: repeat(2, 1fr);
}

.kp-highlights__grid[data-columns="4"] {
  grid-template-columns: repeat(4, 1fr);
}

@media (max-width: 900px) {
  .kp-highlights__grid,
  .kp-highlights__grid[data-columns="2"],
  .kp-highlights__grid[data-columns="4"] {
    grid-template-columns: 1fr;
  }
}

@media (min-width: 600px) and (max-width: 1100px) {
  .kp-highlights__grid[data-columns="4"] {
    grid-template-columns: repeat(2, 1fr);
  }
}

.kp-highlight {
  background: var(--color-bg-elevated);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: var(--radius);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: border-color 0.2s ease, transform 0.2s ease;
}

.kp-highlight:hover {
  border-color: rgba(0, 229, 168, 0.35);
  transform: translateY(-3px);
}

.kp-highlight__media {
  aspect-ratio: 4 / 3;
  overflow: hidden;
  background: #1c1c1f;
}

.kp-highlight__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.kp-highlight:hover .kp-highlight__media img {
  transform: scale(1.04);
}

.kp-highlight__body {
  padding: 1.25rem 1.25rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  flex: 1;
}

.kp-highlight__eyebrow {
  display: inline-block;
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: var(--color-accent);
}

.kp-highlight__eyebrow:empty {
  display: none;
}

.kp-highlight__title {
  font-family: var(--font-display);
  font-size: 1.4rem;
  letter-spacing: 0.04em;
  margin: 0;
  color: var(--color-text);
}

.kp-highlight__text {
  color: var(--color-text-muted);
  font-size: 0.95rem;
  line-height: 1.55;
  margin: 0;
}

.kp-highlight__link {
  margin-top: auto;
  padding-top: 0.5rem;
  font-size: 0.85rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-accent);
  align-self: flex-start;
}

.kp-highlight__link:hover {
  opacity: 0.8;
}

.kp-highlights__cta {
  display: flex;
  justify-content: center;
  margin-top: clamp(2rem, 5vw, 3rem);
}

/* Editorial Banner */
.kp-banner {
  position: relative;
  display: grid;
  align-items: center;
  min-height: min(60vh, 560px);
  padding: clamp(3rem, 8vw, 5rem) var(--space);
  overflow: hidden;
  isolation: isolate;
}

.kp-banner[data-height="compact"],
.kp-banner:has(.kp-banner__content[data-height="compact"]) {
  min-height: min(40vh, 380px);
}

.kp-banner[data-height="tall"],
.kp-banner:has(.kp-banner__content[data-height="tall"]) {
  min-height: min(85vh, 760px);
}

.kp-banner__media {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.kp-banner__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: saturate(1.05) contrast(1.05);
}

.kp-banner__overlay {
  --banner-overlay: 70;
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    linear-gradient(
      180deg,
      rgba(10, 10, 11, 0.15) 0%,
      rgba(10, 10, 11, 0.55) 100%
    ),
    linear-gradient(
      90deg,
      rgba(10, 10, 11, calc(var(--banner-overlay) / 100)) 0%,
      rgba(10, 10, 11, calc(var(--banner-overlay) / 100 * 0.85)) 30%,
      rgba(10, 10, 11, calc(var(--banner-overlay) / 100 * 0.35)) 70%,
      rgba(10, 10, 11, 0) 100%
    );
}

.kp-banner__content {
  position: relative;
  z-index: 2;
  max-width: 56ch;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.kp-banner__content[data-align="center"] {
  text-align: center;
  margin-inline: auto;
  align-items: center;
}

.kp-banner__content[data-align="right"] {
  margin-left: auto;
  text-align: right;
  align-items: flex-end;
}

.kp-banner:has(.kp-banner__content[data-align="right"]) .kp-banner__overlay {
  background:
    linear-gradient(
      180deg,
      rgba(10, 10, 11, 0.15) 0%,
      rgba(10, 10, 11, 0.55) 100%
    ),
    linear-gradient(
      270deg,
      rgba(10, 10, 11, calc(var(--banner-overlay) / 100)) 0%,
      rgba(10, 10, 11, calc(var(--banner-overlay) / 100 * 0.85)) 30%,
      rgba(10, 10, 11, calc(var(--banner-overlay) / 100 * 0.35)) 70%,
      rgba(10, 10, 11, 0) 100%
    );
}

.kp-banner:has(.kp-banner__content[data-align="center"]) .kp-banner__overlay {
  background:
    radial-gradient(
      ellipse at center,
      rgba(10, 10, 11, calc(var(--banner-overlay) / 100 * 0.75)) 0%,
      rgba(10, 10, 11, calc(var(--banner-overlay) / 100 * 0.4)) 60%,
      rgba(10, 10, 11, 0.2) 100%
    ),
    linear-gradient(
      180deg,
      rgba(10, 10, 11, 0.1) 0%,
      rgba(10, 10, 11, 0.5) 100%
    );
}

.kp-banner__title {
  font-family: var(--font-display);
  font-size: clamp(2.25rem, 6vw, 4rem);
  line-height: 0.95;
  letter-spacing: 0.02em;
  margin: 0;
  max-width: 18ch;
  text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
}

.kp-banner__text {
  color: #e4e4e7;
  font-size: 1.05rem;
  margin: 0;
  max-width: 42ch;
  text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
}

.kp-banner__actions {
  display: flex;
